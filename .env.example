# ---- LiveKit (self-hosted) ----
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=changeme
LIVEKIT_API_SECRET=changeme
LIVEKIT_SIP_INBOUND_TRUNK_ID=            # written by scripts/provision_livekit.py
AGENT_NAME=inbound-receptionist

# ---- Model providers (MVP: hosted; all swappable) ----
STT_PROVIDER=deepgram                     # deepgram | whisper_local (later)
DEEPGRAM_API_KEY=
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.anthropic.com/v1/   # any OpenAI-compatible endpoint; vLLM later
LLM_API_KEY=
LLM_MODEL=
TTS_PROVIDER=cartesia                     # cartesia | elevenlabs | kokoro_local (later)
CARTESIA_API_KEY=
TTS_VOICE_ID=                             # British English voice, chosen by Noel

# ---- HubSpot (auth: Service Keys, not a legacy private app) ----
HUBSPOT_SERVICE_KEY=                       # runtime key used by the agent (agent/hubspot client)
HUBSPOT_PROVISION_KEY=                     # provisioning key for scripts/provision_hubspot.py
HUBSPOT_PORTAL_ID=
HUBSPOT_EXPERT_OWNER_ID=99735767          # Noel Sesto
HUBSPOT_DEAL_PIPELINE_ID=default          # existing "Sales Pipeline" (Starter: 2 pipelines max)
HUBSPOT_STAGE_DISCOVERY_BOOKED=6139983094        # "Initial Contact"
HUBSPOT_STAGE_QUALIFIED_NOT_BOOKED=6139983093    # "Lead Identified"

# ---- Cal.com (discovery-call booking; replaces HubSpot Scheduler) ----
CALCOM_API_KEY=                            # account noelsesto
CALCOM_EVENT_TYPE_ID=7103844               # "LiftPulse Trial", 15-min intro, auto-confirmed

# ---- Neon ----
DATABASE_URL=postgresql://user:pass@host/receptionist?sslmode=require
WINDMILL_DATABASE_URL=postgresql://user:pass@host/windmill?sslmode=require

# ---- Windmill ----
WINDMILL_BASE_URL=https://windmill.example.internal
WINDMILL_DOMAIN=windmill.example.internal  # hostname only; Caddy terminates TLS for it
WINDMILL_POST_CALL_WEBHOOK=               # flow webhook URL for post_call
WINDMILL_WEBHOOK_TOKEN=

# ---- Telnyx (SIP trunk + UK DID; ingress) — no credentials yet (account upgrade pending) ----
TELNYX_API_KEY=                           # Telnyx API key (provisioning)
TELNYX_DID=                               # UK number (E.164) RingCentral diverts to
TELNYX_SIP_CONNECTION_ID=                 # Telnyx SIP connection routing the DID to LiveKit SIP
TELNYX_SIP_USERNAME=                      # if the trunk uses credential auth (else IP allowlist)
TELNYX_SIP_PASSWORD=

# ---- Business config ----
BUSINESS_TZ=Europe/London
RECORDINGS_DIR=/var/recordings
RECORDING_RETENTION_DAYS=90
MAX_CALL_SECONDS=480
