# ---- ElevenLabs Agents (voice loop + telephony ingress) ----
ELEVENLABS_API_KEY=                        # account key (also used by the `elevenlabs agents` CLI)
ELEVENLABS_AGENT_ID=                       # the inbound-receptionist agent
ELEVENLABS_WEBHOOK_SECRET=                 # HMAC secret for the post_call_transcription webhook
ELEVENLABS_TOOL_SECRET=                    # shared secret header the agent sends to our tool webhooks
# Voice, model and privacy (record_voice=false, retention_days=30) live in the ElevenLabs agent
# config; the British-English voice id is still to be chosen (QUESTIONS).

# ---- HubSpot (auth: Service Keys, not a legacy private app) ----
HUBSPOT_SERVICE_KEY=                       # runtime key used by the agent (agent/hubspot client)
HUBSPOT_PROVISION_KEY=                     # provisioning key for scripts/provision_hubspot.py
HUBSPOT_PORTAL_ID=
HUBSPOT_EXPERT_OWNER_ID=99735767          # Noel Sesto
HUBSPOT_DEAL_PIPELINE_ID=default          # existing "Sales Pipeline" (Starter: 2 pipelines max)
HUBSPOT_STAGE_DISCOVERY_BOOKED=6139983094        # "Initial Contact"
HUBSPOT_STAGE_QUALIFIED_NOT_BOOKED=6139983093    # "Lead Identified"

# ---- Cal.com (discovery-call booking; replaces HubSpot Scheduler) ----
CALCOM_API_KEY=                            # account noelsesto
CALCOM_EVENT_TYPE_ID=7103844               # "LiftPulse Trial", 15-min intro, auto-confirmed

# ---- Neon ----
DATABASE_URL=postgresql://user:pass@host/receptionist?sslmode=require
WINDMILL_DATABASE_URL=postgresql://user:pass@host/windmill?sslmode=require

# ---- Windmill ----
WINDMILL_BASE_URL=https://windmill.example.internal
WINDMILL_DOMAIN=windmill.example.internal  # hostname only; Caddy terminates TLS for it
WEBHOOK_DOMAIN=hooks.example.internal      # public HTTPS host for the ElevenLabs webhook service
WINDMILL_POST_CALL_WEBHOOK=               # flow webhook URL for post_call
WINDMILL_WEBHOOK_TOKEN=

# ---- Telnyx (SIP trunk + UK DID; ingress) — no credentials yet (account upgrade pending) ----
# Inbound-only: the Telnyx→ElevenLabs trunk authenticates by Allowed Source IPs — no SIP username/password.
TELNYX_DID=                               # London 020 number (E.164) RingCentral diverts to
TELNYX_API_KEY=                           # only to provision/manage or fetch via the Telnyx API
TELNYX_SIP_CONNECTION_ID=                 # only if provisioning the SIP connection via API

# ---- Notion (Phase 4 "Call transcripts" pitch-review database) — secrets to come ----
NOTION_API_KEY=                           # Notion integration token
NOTION_TRANSCRIPTS_DB_ID=                 # Notion database: one row per call

# ---- Business config ----
BUSINESS_TZ=Europe/London
MAX_CALL_SECONDS=480
# No audio recording in the MVP, so no RECORDINGS_DIR / RECORDING_RETENTION_DAYS; the
# calls.recording_path column stays as the only placeholder (SPEC §8).
