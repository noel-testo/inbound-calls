# ---- ElevenLabs Agents (voice loop + telephony ingress) ----
ELEVENLABS_API_KEY=                        # account key (also used by the `elevenlabs agents` CLI)
ELEVENLABS_AGENT_ID=agent_6901m4gzr6bdfjwsmte3fxepq946   # "ControlFreq receptionist (Cody)"
ELEVENLABS_PHONE_NUMBER_ID=                # imported SIP-trunk number for TELNYX_DID (provision_elevenlabs.py prints it)
ELEVENLABS_WEBHOOK_SECRET=                 # HMAC secret for the post_call_transcription webhook (verified by n8n)
ELEVENLABS_TOOL_SECRET=                    # shared secret ElevenLabs sends as X-Cody-Secret on the three tool webhooks
# Voice, model and privacy (voice_id=jRAAK67SEFE9m7ci5DhD, record_voice=false, retention_days=30) live
# in the ElevenLabs agent config, set by scripts/provision_elevenlabs.py.
INIT_LOOKUP_TIMEOUT_MS=1500                # budget for n8n's conversation-init Notion lookup; on timeout the call starts generic. Not read by the Python service.

# ---- Cal.com (discovery-call booking) ----
CALCOM_API_KEY=                            # account noelsesto
CALCOM_EVENT_TYPE_ID=7103844               # "LiftPulse Trial", 15-min intro, auto-confirmed

# ---- Webhook service ----
WEBHOOK_DOMAIN=hooks.example.internal      # public HTTPS host for the ElevenLabs tool webhook service

# ---- Telnyx (SIP trunk + UK DID; ingress) ----
# Inbound-only: the Telnyx→ElevenLabs trunk authenticates by Allowed Source IPs — no SIP username/password.
TELNYX_DID=+442045200783                  # London 020 number RingCentral diverts to (replaces +443301900784)
TELNYX_API_KEY=                           # only to provision/manage or fetch via the Telnyx API
TELNYX_SIP_CONNECTION_ID=                 # FQDN connection id (scripts/provision_telnyx.py prints it)

# Apollo, Notion and Slack are post-call, which runs in n8n; the Python service does not read these.
# NOTION_* are still used by scripts/provision_notion.py.

# ---- Apollo (post-call, qualified callers only; never during a call, never sequences) ----
APOLLO_API_KEY=                           # Apollo *master* API key (call records need it)
APOLLO_USER_ID=                           # Apollo user who owns the logged call, the deal and the follow-up task
APOLLO_CREATE_DEALS=false                 # keep false until Apollo's automatic HubSpot sync is switched off
APOLLO_DEAL_STAGE_ID=                     # optional: Apollo opportunity_stage_id for new deals (blank = Apollo default)
APOLLO_TASK_DUE_HOURS=4                   # follow-up task due this many hours after the call

# ---- Notion (caller directory, lead review + call transcripts) ----
NOTION_API_KEY=                           # Notion internal integration token (share both databases with it)
NOTION_LEADS_DB_ID=                       # "Cody leads" database: one row per call; its Phone field (+44 E.164) is the caller lookup
NOTION_TRANSCRIPTS_DB_ID=                 # "Call transcripts" database: one row per call, transcript in the body

# ---- Slack ----
SLACK_WEBHOOK_URL=                        # incoming webhook for the qualified-call alert channel

# ---- Business config ----
BUSINESS_TZ=Europe/London
MAX_CALL_SECONDS=480
# No audio recording in the MVP, so no RECORDINGS_DIR / RECORDING_RETENTION_DAYS (SPEC §8).
