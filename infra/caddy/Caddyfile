# TLS for the two HTTPS surfaces on this host: the Windmill UI and the ElevenLabs webhook service.
# Domains come from ../.env (WINDMILL_DOMAIN, WEBHOOK_DOMAIN); Caddy auto-obtains certs over 80/443.
{$WINDMILL_DOMAIN} {
	reverse_proxy windmill-server:8000
}

{$WEBHOOK_DOMAIN} {
	reverse_proxy agent:8080
}
